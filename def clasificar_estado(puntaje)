def clasificar_estado(puntaje):
    if puntaje >= 8:
        categoria = "Energetic"
    elif puntaje >= 6:
        categoria = "Happy"
    elif puntaje >= 4:
        categoria = "Calm"
    else:
        categoria = "Sad"

    return categoria

